{
	"name": "@minex-labs/lore",
	"version": "0.7.1",
	"description": "Curated, versioned decision records that coding agents actually read before touching your code.",
	"license": "MIT",
	"author": "Martin Mineo <martinmineo@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/minex-labs/lore.git"
	},
	"bugs": {
		"url": "https://github.com/minex-labs/lore/issues"
	},
	"homepage": "https://github.com/minex-labs/lore#readme",
	"keywords": [
		"adr",
		"decision-records",
		"cli",
		"claude",
		"agents",
		"context"
	],
	"bin": {
		"lore": "dist/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "rm -rf dist && node ./node_modules/typescript/bin/tsc && chmod +x dist/cli.js",
		"dev": "node ./node_modules/typescript/bin/tsc --watch",
		"start": "node dist/cli.js",
		"lint": "eslint source test",
		"lint:fix": "eslint source test --fix",
		"format": "prettier --write source test",
		"test": "node --import tsx --test test/*.test.ts",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist",
		"README.md"
	],
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"picomatch": "^4.0.0",
		"yaml": "^2.0.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/picomatch": "^4.0.0",
		"@typescript-eslint/eslint-plugin": "^8.52.0",
		"@typescript-eslint/parser": "^8.52.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"prettier": "^3.7.4",
		"tsx": "^4.22.4",
		"typescript": "^5.7.0"
	}
}
